# Telegram API credentials (required).
# Get a shared api_id / api_hash from the person who gave you this toolkit,
# or create your own at https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Session string — generated by running: uv run login.py
# Keep this private. Anyone with this string can access your Telegram account.
TELEGRAM_SESSION_STRING=
